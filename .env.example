# 이 파일을 복사해서 .env 로 만들고 본인 키를 넣으세요. (.env 는 저장소에 올라가지 않습니다)
# https://openweathermap.org 가입 후 API keys 탭에서 발급받을 수 있습니다.
VITE_OPENWEATHER_KEY=여기에_본인_API_키

# 선택. 비워두면 기본 주소(https://api.openweathermap.org)를 쓴다.
# 빌드 모드별 값은 .env.staging / .env.production 에 있다.
VITE_API_URL=https://api.openweathermap.org
